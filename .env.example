# Token da integração do Notion (Internal Integration Secret).
# Crie em https://www.notion.so/my-integrations e compartilhe o
# Hub Central MED 1.5 com a integração (ver seção 3 do log de arquitetura).
#
# Na sessão em nuvem do Claude Code esta variável é DISPENSÁVEL: o agent proxy
# injeta a autenticação automaticamente (ADR-001). Ela é necessária para rodar
# na sua máquina.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Modelo de capacidade (item 2) ────────────────────────────────
# Horas acordado-produtivas de um dia. É uma PREMISSA: ajuste ao seu dia real.
JANELA_UTIL_H=14
# Teto de estudo num dia comum. Vem da regra de adaptação do Motor · Claude.
TETO_ESTUDO_DIA_H=6

# ── Otimizador por LLM (item 3, opcional) ────────────────────────
# Sem esta chave, o Jarvis usa o otimizador determinístico por taxonomia,
# que é o padrão e está coberto por testes. Com ela, a síntese da diretriz
# passa a ser feita por LLM — caminho ainda NÃO exercitado.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
